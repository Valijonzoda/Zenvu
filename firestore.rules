rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      match /favorites/{channelId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['kind', 'nanoid', 'name', 'country', 'addedAt'])
          && request.resource.data.kind in ['tv', 'radio', 'webcams']
          && request.resource.data.nanoid is string
          && request.resource.data.nanoid.size() > 0
          && request.resource.data.nanoid.size() < 80
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() < 300
          && request.resource.data.country is string
          && request.resource.data.country.size() < 8
          && request.resource.data.addedAt is timestamp;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
